{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "enabled_providers": ["@@PROVIDER_ID@@"],
  "model": "@@PROVIDER_ID@@/@@MODEL_ID@@",
  "provider": {
    "@@PROVIDER_ID@@": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {"baseURL": "http://@@HOST@@:@@PORT@@/v1"},
      "models": {
        "@@MODEL_ID@@": {
          "name": "@@MODEL_ID@@",
          "limit": {"context": "@@CONTEXT@@", "output": "@@OUTPUT@@"}
        }
      }
    }
  },
  "permission": {
    "*": "deny",
    "read": {"*": "allow", "*.env": "deny", "*.env.*": "deny"},
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "edit": "allow",
    "bash": {
      "*": "deny",
      "pytest": "allow",
      "pytest *": "allow",
      "python -m pytest": "allow",
      "python -m pytest *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "cat /*": "deny",
      "cat ~*": "deny",
      "ls /*": "deny",
      "ls ~*": "deny",
      "*..*": "deny"
    },
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "task": "deny",
    "skill": "deny",
    "lsp": "deny",
    "question": "deny",
    "doom_loop": "deny"
  }
}
