# docs/recon/commands.env — T-001 S4. Bash-sourceable command variables for
# Stage 4 (T-007/T-008) and the release checks. The six CMD variables are
# single-quoted: $SESSION expands when a command is evaluated, not when this
# file is sourced.
# Sources: docs/runbook-stage3.md sections 3, 4, 6; .github/workflows/ci.yml;
# each tool's --help (read 2026-11-13); pass signatures from
# src/smallpc/stage3/cli.py, gate.py, repro.py and src/smallpc/scrub.py.
# Usage: SESSION=stage4; source docs/recon/commands.env; eval "$GATE_CMD"
SESSION="${SESSION:-stage4}"

# Runbook section 6 (Stage 4 gate). For a Stage 3 session use
# --spec configs/sweeps/stage3.toml (runbook sections 3-4). Add --json for the
# full record.
# Pass signature: exit 0 = pass (cli.py:50); the record carries "pass": true
# and "failed": [] (gate.py:152-153); runbook section 4: "exit 0 = pass".
GATE_CMD='uv run python -m smallpc.stage3 gate --session data/raw/$SESSION --spec configs/sweeps/stage4.toml'

# Interval-coverage simulation (WP10/WP11 decisions, docs/decisions.md).
# Add --ratio for the paired-ratio coverage; --experiments/--resamples/--seed/
# --json per the tool's --help.
COVERAGE_CMD='uv run python -m smallpc.stats coverage'

# Runbook section 6, the S2 check (Stage 4 vs the Stage 3 64K session).
# Pass signature: exit 0 = all PASS (cli.py:60; runbook section 6: "Exit 0 =
# all PASS"). With the R1 all-units fallback the FIRST line reads "**S2
# evaluated on ALL units (flagged units included) for: <cell> (<day> has <n>
# clean of <m> unit(s))...**" (repro.py:43-48); every metric is followed by
# "- <cell>, <metric>: evaluated on clean units|all units" (repro.py:52).
REPRO_CMD='uv run python -m smallpc.stage3 repro --original data/raw/stage3-64K --rerun data/raw/$SESSION --cells stock-64K,tuned-64K'

# Report render for one session (runbook section 3 shows the combined Stage 3
# form: --sessions data/raw/stage3-32K data/raw/stage3-64K data/raw/stage3-128K
# --out reports/stage3). The sanity path is the ACTUAL file name (D7: the
# runbook's stage3-all.json was a recorded deviation).
REPORT_CMD='uv run python -m smallpc.report render --sessions data/raw/$SESSION --out reports/$SESSION --label results --sanity data/sanity/stage3-tuned.json'

# Scrub check over the publication paths (card T-001 S4).
# Pass signature: exit 0 = clean; exit 1 prints file:line:kind findings
# (scrub.py:142-156; recon A9).
SCRUB_CMD='uv run python -m smallpc.scrub --check data reports docs'

# The CI workflow's commands, chained in order (.github/workflows/ci.yml).
CI_CMD='uv sync --frozen && uv run ruff check && uv run ruff format --check && uv run pytest -m "not gpu" && shellcheck scripts/*.sh'
